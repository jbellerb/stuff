{
  "languages": {
    "JSONC": { "formatter": { "language_server": { "name": "biome" } } },
    "Starlark": { "language_servers": ["buck2-lsp", "!starpls", "!tilt"] }
  },

  "lsp": {
    "gopls": {
      "initialization_options": {
        "build.workspaceFiles": [
          "**/BUCK",
          "**/PACKAGE",
          "**/*.bzl",
          "**/.buckconfig"
        ]
      }
    }
  }
}
