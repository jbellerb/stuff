{
  "languages": {
    "JavaScript": { "language_servers": ["oxfmt", "oxlint"] },
    "JSONC": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "Starlark": { "language_servers": ["buck2-lsp", "!starpls", "!tilt"] },
    "TypeScript": { "language_servers": ["oxfmt", "oxlint"] }
  },

  "lsp": {
    "gopls": {
      "initialization_options": {
        "build.workspaceFiles": [
          "**/BUCK",
          "**/PACKAGE",
          "**/*.bzl",
          "**/.buckconfig"
        ]
      }
    },
    "pyrefly": {
      "settings": {
        "python": {
          "pythonPath": "predictions-coreml/models/.venv/bin/python"
        },
        "pyrefly": {
          "python_interpreter": "predictions-coreml/models/.venv/bin/python"
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "overrideCommand": ["rust-project", "check", "$saved_file"]
        },
        "workspace": {
          "discoverConfig": {
            "command": ["rust-project", "develop-json", "{arg}"],
            "progressLabel": "buck2/rust-project",
            "filesToWatch": ["BUCK"]
          }
        }
      }
    }
  }
}
