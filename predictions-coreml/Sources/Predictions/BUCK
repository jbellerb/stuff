_SWIFT_COMPAT_LIB_PATH = read_root_config(
    "apple",
    "swift_compat_lib_path",
    "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-6.2/macosx",
)

apple_binary(
    name = "predictions",
    srcs = [
        "Predictions.swift",
        "//predictions-coreml:release_version",
    ],
    deps = [
        "//third-party/swift/github.com/apple/swift-argument-parser:ArgumentParser",
