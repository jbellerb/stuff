load(":defs.bzl", "deno_toolchain")

remote_file(
    name = "deno-aarch64-apple-darwin.zip",
    sha256 = "5cd46d6268f6f78f5d88bdc7159d20bd44cdaa4b3303474839f87ec6fe7ae25c",
    type = "exploded_zip",
    url = "https://github.com/denoland/deno/releases/download/v2.9.7/deno-aarch64-apple-darwin.zip",
)

remote_file(
    name = "deno-x86_64-unknown-linux-gnu.zip",
    sha256 = "c6527f24f4b16031d3ae4fa9f658d5f11534c8d84ce7dc8502420280919c3490",
    type = "exploded_zip",
    url = "https://github.com/denoland/deno/releases/download/v2.9.7/deno-x86_64-unknown-linux-gnu.zip",
)

genrule(
    name = "deno-aarch64-apple-darwin",
    cmd = "ln -s $(location :deno-aarch64-apple-darwin.zip)/deno $OUT",
    executable = True,
    out = "deno",
)

genrule(
    name = "deno-x86_64-unknown-linux-gnu",
    cmd = "ln -s $(location :deno-x86_64-unknown-linux-gnu.zip)/deno $OUT",
    executable = True,
    out = "deno",
)

alias(
    name = "binary",
    actual = select({
        "config//os:linux": ":deno-x86_64-unknown-linux-gnu",
        "config//os:macos": ":deno-aarch64-apple-darwin",
    }),
    visibility = ["PUBLIC"],
)

deno_toolchain(
    name = "deno",
    deno = select({
        "config//os:linux": ":deno-x86_64-unknown-linux-gnu",
        "config//os:macos": ":deno-aarch64-apple-darwin",
    }),
    visibility = ["toolchains//..."],
)
