http_archive(
    name = "protoc-gen-go-grpc.v1.6.1.darwin.arm64",
    sha256 = "55d96d01811710865b0531de287d60699b89c54d81c6127f07bf492a3ad08809",
    urls = ["https://github.com/grpc/grpc-go/releases/download/cmd%2Fprotoc-gen-go-grpc%2Fv1.6.1/protoc-gen-go-grpc.v1.6.1.darwin.arm64.tar.gz"],
)

genrule(
    name = "protoc-gen-go-grpc",
    out = "protoc-gen-go-grpc",
    cmd = "ln -sF $(location :protoc-gen-go-grpc.v1.6.1.darwin.arm64)/protoc-gen-go-grpc $OUT",
    executable = True,
)

protobuf_plugin(
    name = "protobuf-go-plugin",
    plugin = ":protoc-gen-go",
    language = "go",
    extensions = [".pb.go"],
)

protobuf_plugin(
    name = "protobuf-go-grpc-plugin",
    plugin = ":protoc-gen-go-grpc",
    language = "go-grpc",
    extensions = ["_grpc.pb.go"],
)

protobuf_toolchain(
    name = "protobuf",
    protoc = ":protoc",
    plugins = [":protobuf-go-plugin", ":protobuf-go-grpc-plugin"],
    visibility = ["toolchains//..."],
)
