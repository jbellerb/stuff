load(":defs.bzl", "protobuf_plugin", "protobuf_toolchain")

http_archive(
    name = "protoc-34.0-rc-2-osx-aarch_64",
    sha256 = "2569852ef56a41c40e476e47a6627af132b87cf8b0f3f8b3ad8868d0c570e2de",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v34.0-rc2/protoc-34.0-rc-2-osx-aarch_64.zip"],
)

genrule(
    name = "protoc",
    out = "protoc",
    cmd = "ln -sF $(location :protoc-34.0-rc-2-osx-aarch_64)/bin/protoc $OUT",
    executable = True,
)

