load("@toolchains//css:rules.bzl", "css_bundle")
load("@toolchains//typescript:rules.bzl", "oxlint_lint", "typescript_bundle", "typescript_library")
load(":defs.bzl", "css_stylesheet")

TARGETS = ["chrome142", "firefox140", "safari18", "ios18"]
CSS_TARGETS = ["chrome >= 142", "firefox >= 140", "safari >= 18", "ios_saf >= 18"]

export_file(
    name = "index",
    src = "index.html",
    visibility = ["//remote/..."],
)

css_stylesheet(
    name = "xterm-css",
    package = "//third-party/js/npm/@xterm/xterm:xterm",
    path = "css/xterm.css",
)

typescript_library(
    name = "app",
    deps = [
        ":xterm-css",
        "//third-party/js/npm/@xterm/xterm:xterm",
    ],
    lib = ["esnext", "dom", "dom.iterable"],
    main = "app.ts",
)

typescript_bundle(
    name = "bundle-js",
    entrypoints = {"index.js": ":app"},
    minify = True,
    platform = "browser",
    target = TARGETS,
    visibility = ["//remote/..."],
)

css_bundle(
    name = "bundle-css",
    entrypoint = "main.css",
    minify = True,
    outfile = "main.css",
    targets = CSS_TARGETS,
    visibility = ["//remote/..."],
)

oxlint_lint(
    name = "lint",
    srcs = ["app.ts"],
    categories = {"correctness": "error"},
    env = {"browser": True},
)
