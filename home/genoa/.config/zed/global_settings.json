{
  "auto_update": false,

  "theme": {
    "dark": "Alabaster Dark",
    "light": "Alabaster BG",
    "mode": "system"
  },
  "buffer_font_size": 16,
  "buffer_font_family": "iA Writer Mono V",
  "buffer_line_height": "comfortable",
  "ui_font_size": 18,
  "ui_font_family": "IBM Plex Sans",
  "hour_format": "hour24",

  "helix_mode": true,

  "terminal": {
    "shell": {
      "program": "fish"
    }
  },

  "auto_install_extensions": {
    "alabaster": true,
    "html": true,
    "nix": true,
    "starlark": true,
    "toml": true,
    "git-firefly": true,
    "elixir": true,
    "swift": true,
    "biome": true
  },

  "languages": {
    "Nix": { "language_servers": ["nixd", "!nil"] },
    "Starlark": { "language_servers": ["buck2-lsp", "!starpls", "!tilt"] },
    "Git Commit": {
      "preferred_line_length": 72,
      "wrap_guides": [50, 72]
    },
    "Go": { "wrap_guides": [80, 100] }
  }
}
