{
  "auto_update": false,

  "auto_install_extensions": {
    "alabaster": true,
    "biome": true,
    "deno": true,
    "elixir": true,
    "git-firefly": true,
    "glsl": true,
    "haskell": true,
    "html": true,
    "lua": true,
    "nix": true,
    "pyrefly": true,
    "starlark": true,
    "swift": true,
    "toml": true
  },
  "auto_update_extensions": {
    "alabaster": false,
    "biome": false,
    "deno": false,
    "elixir": false,
    "git-firefly": false,
    "glsl": false,
    "haskell": false,
    "html": false,
    "lua": false,
    "nix": false,
    "pyrefly": false,
    "starlark": false,
    "swift": false,
    "toml": false
  },

  "theme": {
    "dark": "Alabaster Dark",
    "light": "Alabaster BG",
    "mode": "system"
  },
  "buffer_font_size": 16,
  "buffer_font_family": "iA Writer Mono V",
  "buffer_line_height": "comfortable",
  "ui_font_size": 18,
  "ui_font_family": "IBM Plex Sans",
  "diff_view_style": "unified",
  "hour_format": "hour24",

  "helix_mode": true,

  "terminal": {
    "shell": {
      "program": "fish"
    }
  },

  "languages": {
    "Git Commit": {
      "preferred_line_length": 72,
      "wrap_guides": [50, 72]
    },
    "Go": { "wrap_guides": [80, 100] },
    "Nix": { "language_servers": ["nixd", "!nil"] },
    "Python": { "language_servers": ["pyrefly", "ruff", "!basedpyright"] },
    "Swift": { "wrap_guides": [80, 100] }
  }
}
