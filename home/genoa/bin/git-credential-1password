#!/usr/bin/env sh

if test -z "$NO_COLOR"
then
    BOLD=$(printf "\033[1m")
    RED=$(printf "\033[31m")
    YELLOW=$(printf "\033[33m")
    PURPLE=$(printf "\033[35m")
    RESET_COLOR=$(printf "\033[39m")
    RESET=$(printf "\033[0m")
fi

OP=${OP:-op}

git_credential_1password_error() {
    echo "${BOLD}${RED}Error:${RESET} ${BOLD}$1${RESET}" >&2
    return 1
}

git_credential_1password_read_request() {
    while IFS= read -r line && test -n "$line"
    do
        case "$line" in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
        username=*) username=${line#username=} ;;
        esac
    done
}

git_credential_1password_get_field() {
    item=$1
    vault=$2
    field=$3

    if test -n "$vault"
    then
        "$OP" item get "$item" --vault "$vault" --fields "label=$field" \
            --reveal 2>&1
    else
        "$OP" item get "$item" --fields "label=$field" --reveal 2>&1
    fi
}

git_credential_1password_get() {
    item=$1
    vault=$2
    username_field=$3
    password_field=$4

    git_credential_1password_read_request

    test -n "$item" || item=$host
    test -n "$item" || \
        git_credential_1password_error "No item given and no host in request" || \
        return

    password=$(
        git_credential_1password_get_field "$item" "$vault" "$password_field"
    ) || git_credential_1password_error "${password#\[ERROR\] * * }" || return
    test -n "$password" || \
        git_credential_1password_error "Field '$password_field' of item '$item' is empty" || \
        return

    if found_username=$(
        git_credential_1password_get_field "$item" "$vault" "$username_field"
    ) && test -n "$found_username"
    then
        username=$found_username
    fi

    test -n "$protocol" && echo "protocol=$protocol"
    test -n "$host" && echo "host=$host"
    test -n "$username" && echo "username=$username"
    echo "password=$password"
}

username_field=username
password_field=password

while test $# -gt 0
do
    case "$1" in
    --vault|-v) shift; vault="$1" ;;
    --username-field|-u) shift; username_field="$1" ;;
    --password-field|-p) shift; password_field="$1" ;;
    -*)
        git_credential_1password_error "Unexpected argument '${YELLOW}$1${RESET_COLOR}' found"
        exit 2
        ;;
    *)
        test $# -gt 1 && item="$1" || command="$1"
        ;;
    esac
    shift
done

case "$command" in
get)
    git_credential_1password_get "$item" "$vault" "$username_field" \
        "$password_field"
    ;;
store|erase) cat > /dev/null ;;
*)
    git_credential_1password_error "unknown command: '${YELLOW}$command${RESET_COLOR}'"
    exit 2
    ;;
esac
